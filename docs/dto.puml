@startuml

package AuthDTO {
    class UserProfile {
        -first_name: String
        -last_name: String
        -balance: Decimal
    }

    class UserAccount {
        -first_name: String
        -last_name: String
        -email: String
        -phone: String
        -address: String
        -city: String
        -zip_code: String
    }

    class UserLogin {
        -email: String
        -password: String
    }

    class UserRegister {
        -email: String
        -first_name: String
        -last_name: String
        -password: String
    }

    class UserResetPassword {
        -old_password: String
        -new_password: String
    }
}

package LotDTO {
    class PaginatedLot<T> {
        -content: T[]
        -page: Integer
        -take: Integer
        -total: Long
        -details: Map<String, Object>
    }

    class LotFilter {
        -category_id: Integer
        -search: String
        -min_price: Decimal
        -max_price: Decimal
    }

    class LotThumbnail {
        -id: Long
        -name: String
        -location: String
        -initial_price: Decimal
        -last_price: Decimal
        -thumbnail: String
    }

    class LotDetails {
        -id: Long
        -name: String
        -description: String
        -location: String
        -initial_price: Decimal
        -last_price: Decimal
        -medias: String[]
        -publish_date: DateTime
        -close_date: DateTime
        -transfer_date: DateTime
        -first_auction_date: Decimal
        -last_auction_date: Decimal
        -is_last_bidder: boolean
        -is_seller: boolean
        -category: Category[]
        -auctions: Auction[]
    }

    class LotHistory {
        -id: Long
        -name: String
        -short_desc: String
        -location: String
        -initial_price: Decimal
        -last_price: Decimal
        -thumbnail: String
        -publish_date: DateTime
        -close_date: DateTime
        -transfer_date: DateTime
        -is_last_bidder: boolean
    }

    class LotCreation {
        -name: String
        -description: String
        -location: String
        -initial_price: Decimal
        -publish_date: DateTime
        -close_date: DateTime
        -category_id: Integer
    }

    class LotMediaAction {
        -action: String
        -from: Integer
        -to: Integer
    }

    class LotModification {
        -name: String
        -description: String
        -location: String
        -initial_price: Decimal
        -publish_date: DateTime
        -close_date: DateTime
        -category_id: Integer
    }

    class LotTransferResult {
        new_balance: Decimal
    }
}

package AuctionDTO {
    enum TimePeriod {
        -ALL
        -YEAR
        -SEMESTER
        -QUARTER
        -MONTH
        -WEEK
        -DAY
    }

    class AuctionPrice {
        -date: LocalDateTime
        -price: BigDecimal
    }

    class AuctionRequest {
        -price: Decimal
    }

    class AuctionResponse {
        -date: LocalDateTime
        -price: BigDecimal
        -newBalance: BigDecimal
    }
}
@enduml